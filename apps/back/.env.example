POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Составную структуру ссылки мы оставляем, чтобы другой программист видел, как она собирается!
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}?schema=public

FRONTEND_PORT=3000
BACKEND_PORT=8080
# изменить порт apps|back|config|port.ts
